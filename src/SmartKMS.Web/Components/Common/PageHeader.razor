<div class="page-header mb-6" data-testid="page-header">
    <MudText Typo="Typo.h4" Class="page-header-title">@Title</MudText>
    @if (!string.IsNullOrWhiteSpace(Subtitle))
    {
        <MudText Typo="Typo.body2" Color="Color.Default">@Subtitle</MudText>
    }
    @if (Actions is not null)
    {
        <div class="page-header-actions mt-2">@Actions</div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string? Subtitle { get; set; }

    [Parameter]
    public RenderFragment? Actions { get; set; }
}
