<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@(Data is null ? "Tạo lớp học" : "Sửa lớp học")</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" @bind-Errors="_errors" @onsubmit="SubmitAsync">
            <MudTextField @bind-Value="_name"
                          Label="Tên lớp"
                          Required="true"
                          MaxLength="100"
                          data-testid="class-name-input" />
            <MudSelect T="AgeGroup" @bind-Value="_ageGroup" Label="Khối" Required="true" data-testid="class-agegroup-select">
                <MudSelectItem T="AgeGroup" Value="AgeGroup.Mam">Mầm</MudSelectItem>
                <MudSelectItem T="AgeGroup" Value="AgeGroup.Choi">Chồi</MudSelectItem>
                <MudSelectItem T="AgeGroup" Value="AgeGroup.La">Lá</MudSelectItem>
            </MudSelect>
            <MudTextField @bind-Value="_year"
                          Label="Năm học"
                          Required="true"
                          Placeholder="2025-2026"
                          data-testid="class-year-input" />
            <MudTextField @bind-Value="_room"
                          Label="Phòng học"
                          MaxLength="50"
                          data-testid="class-room-input" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Default" Variant="Variant.Outlined" OnClick="Cancel" data-testid="class-dialog-cancel">Hủy</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" data-testid="class-submit-button">Lưu</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public ClassDetailDto? Data { get; set; }

    private MudForm _form = default!;
    private string[] _errors = [];
    private string _name = string.Empty;
    private AgeGroup _ageGroup = AgeGroup.La;
    private string _year = string.Empty;
    private string? _room;

    protected override void OnInitialized()
    {
        if (Data is not null)
        {
            _name = Data.Name;
            _ageGroup = Enum.Parse<AgeGroup>(Data.AgeGroup);
            _year = Data.AcademicYear;
            _room = Data.Room;
        }
    }

    private async Task SubmitAsync()
    {
        await _form.Validate();
        if (_errors.Length > 0)
            return;

        MudDialog.Close(DialogResult.Ok(new ClassFormResult(_name, _ageGroup, _year, _room)));
    }

    private void Cancel() => MudDialog.Close(DialogResult.Cancel());
}
